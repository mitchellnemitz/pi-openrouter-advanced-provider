{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "typeRoots": [
      "../node_modules/@types"
    ],
    "paths": {
      "@earendil-works/pi-ai": [
        "../node_modules/@earendil-works/pi-ai/dist/compat.d.ts"
      ]
    }
  },
  "include": [
    "*.ts"
  ]
}